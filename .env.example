# Backend: "api" (needs ANTHROPIC_API_KEY + credits) or "claude_cli"
# (uses your Claude Code subscription via the `claude` CLI)
AGENT_BACKEND=api
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_TIMEOUT=60

# RAG
ANTHROPIC_API_KEY=your-key-here
MODEL_NAME=claude-sonnet-4-5-20250929
CHUNK_SIZE=500
CHUNK_OVERLAP=50
COLLECTION_NAME=documents
TOP_K=5

# STT (speech-to-text)
# whisper = local faster-whisper (default, offline after first download).
# google  = Google Web Speech API (network). Whisper auto-falls-back to
# google if faster-whisper is not installed.
STT_BACKEND=whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=en

# Orchestrator infra
REDIS_URL=redis://localhost:6379/0
PG_DSN=postgresql://localhost:5432/orchestrator
KAFKA_SERVERS=localhost:9092

# Auth
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
